{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mobile-rag.example/sources_manifest.schema.json",
  "title": "Source Manifest",
  "type": "object",
  "required": ["dataset_id", "schema_version", "sources"],
  "properties": {
    "dataset_id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_key", "file_path", "language"],
        "properties": {
          "source_key": {
            "type": "string",
            "minLength": 1
          },
          "file_path": {
            "type": "string",
            "minLength": 1
          },
          "language": {
            "type": "string",
            "enum": ["ko", "en", "other"]
          },
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
