{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mobile-rag.example/chunk_gold_line.schema.json",
  "title": "Chunk Gold JSONL Line",
  "type": "object",
  "required": [
    "dataset_id",
    "schema_version",
    "item_id",
    "query",
    "language",
    "query_type",
    "gold_source_key",
    "gold_passage"
  ],
  "properties": {
    "dataset_id": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "item_id": {
      "type": "string",
      "minLength": 1
    },
    "query": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "enum": ["ko", "en", "other"]
    },
    "query_type": {
      "type": "string",
      "enum": ["positive", "hard_negative", "paraphrase", "noise"]
    },
    "gold_source_key": {
      "type": "string",
      "minLength": 1
    },
    "gold_chunk_id": {
      "type": "string"
    },
    "gold_passage": {
      "type": "string",
      "minLength": 1
    },
    "gold_span_start": {
      "type": "integer",
      "minimum": 0
    },
    "gold_span_end": {
      "type": "integer",
      "minimum": 0
    },
    "hard_negative_passages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_key", "passage"],
        "properties": {
          "source_key": {
            "type": "string",
            "minLength": 1
          },
          "passage": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "collected_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  },
  "additionalProperties": true
}
